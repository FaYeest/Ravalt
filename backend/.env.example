# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ravalt_user
DB_PASSWORD=ravalt_password
